---
interface Props {
  name: string
  link: string
  description: string
  avatar: string
}

const { name, link, description, avatar } = Astro.props
---

<a
  href={link}
  target="_blank"
  class="group flex items-center gap-4 rounded-lg border border-black/10 bg-zinc-100 p-4 transition-colors hover:border-black/40 dark:border-white/10 dark:bg-zinc-800 dark:hover:border-white/40"
>
  <img
    src={avatar}
    alt={name}
    class="h-10 w-10 rounded-full object-cover dark:bg-white"
  />
  <div>
    <p class="font-medium group-hover:underline">{name}</p>
    <p class="line-clamp-2 text-sm text-neutral-500 dark:text-neutral-400">{description}</p>
  </div>
</a>
