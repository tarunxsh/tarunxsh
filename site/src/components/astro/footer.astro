---
import { OWNER } from "~/config"
import SocialLinks from "./social-links.astro"
const currentYear = new Date().getFullYear()
---

<footer class="select-none py-10">
  <div class="flex justify-between">
    <p>&copy; {currentYear} {OWNER.name}</p>
    <div class="social-links mt-1 flex items-center space-x-2">
      <SocialLinks size={18} iconClass="md:block" />
    </div>
  </div>
  <hr class="mt-1" />
</footer>
