---
interface Heading {
  depth: number
  slug: string
  text: string
}

interface Props {
  headings: Heading[]
}

const { headings } = Astro.props
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3)
---

{
  toc.length > 0 && (
    <>
      <div id="toc-sentinel" />
      <nav id="toc" class="mt-8 sticky top-8 opacity-0 transition-opacity duration-200">
        <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-white/40">
          On this page
        </p>
        <ul class="flex flex-col gap-1">
          {toc.map((h) => (
            <li style={`padding-left: ${(h.depth - 2) * 0.75}rem`}>
              <a
                href={`#${h.slug}`}
                class="text-sm text-gray-500 hover:text-gray-900 dark:text-white/50 dark:hover:text-white transition-colors"
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </>
  )
}

<script>
  function initToc() {
    const sentinel = document.getElementById("toc-sentinel")
    const toc = document.getElementById("toc")
    if (!sentinel || !toc) return

    const observer = new IntersectionObserver(
      ([entry]) => {
        toc.classList.toggle("opacity-0", entry.isIntersecting)
        toc.classList.toggle("opacity-100", !entry.isIntersecting)
      },
      { threshold: 0 }
    )

    observer.observe(sentinel)
  }

  initToc()
  document.addEventListener("astro:after-swap", initToc)
</script>
