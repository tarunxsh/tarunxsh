---
import { META, Favlinks as links } from "~/config"
import blogRollRaw from "~/config/blog-roll-meta.json"
import MainLayout from "~/layouts/main.astro"
import LinkCard from "~/components/astro/link-card.astro"

interface BlogEntry {
  url: string;
  title?: string;
  description?: string;
  author?: string;
  thumbnail?: string;
}
const blogRoll = blogRollRaw as BlogEntry[];

const pageMeta = META.pageMeta
---

<MainLayout
  title={pageMeta.links.title}
  description={pageMeta.links.description}
>
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 mb-10">
    {links.map((link) => <LinkCard {...link} />)}
  </div>

  <div>
    <h2 class="type-section-heading">#BlogRoll</h2>
    <ol class="list-decimal px-10">
    {
      blogRoll.map((entry) => (
          <li>
            <a
              href={entry.url}
              target="_blank"
              class="break-all text-blue-600 visited:text-purple-500/90 hover:underline md:my-2"
            >
              {entry.title || entry.url}
            </a>
          </li>
      ))
    }
    </ol>
  </div>
</MainLayout>
