---
import MainLayout from "~/layouts/main.astro"
import Tags from "~/components/astro/tags.astro"
import TableOfContents from "~/components/astro/table-of-contents.astro"
import { formatDate } from "~/utils"
const { id, title, description, pubDate, updatedDate, heroImage, tags, headings = [] } =
  Astro.props
---

<MainLayout showHeader={false} stickyAside={false}>
  <TableOfContents slot="toc" headings={headings} />
  <article
    class="prose w-full max-w-3xl overflow-hidden dark:prose-invert"
  >
    <div class="not-prose flex flex-col gap-1">
      <h2
        class="type-page-title mb-5"
        transition:name={`post-title-${id}`}
      >
        {title}
      </h2>
      <div class="text-gray-500 dark:text-white/80">
        {formatDate(pubDate)}
      </div>
      <Tags tags={tags} />
    </div>

    <div class="my-6">
      <slot />
    </div>

    <Tags tags={tags} class="pb-10" />
  </article>
</MainLayout>
