---
import { SITE_TITLE } from "~/config"
import SocialLinks from "~/components/astro/social-links.astro"
import ThemeToggle from "~/components/astro/theme-toggle.astro"
---

<header class="flex h-24 w-full select-none items-center justify-between">
  <a href="/" data-umami-event="site-name" aria-label={`${SITE_TITLE}`}>
    <div class="text-4xl font-semibold">{SITE_TITLE}</div>
  </a>

  <div class="flex items-center gap-6">
    <SocialLinks iconClass="hidden md:block" />
    <ThemeToggle />
  </div>
</header>
