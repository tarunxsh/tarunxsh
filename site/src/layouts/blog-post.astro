---
import MainLayout from "~/layouts/main.astro"
import Tags from "~/components/astro/tags.astro"
import { formatDate } from "~/utils"
const { id, title, description, pubDate, updatedDate, heroImage, tags } =
  Astro.props
---

<MainLayout>
  <article
    class="prose w-full max-w-3xl overflow-hidden font-body dark:prose-invert"
  >
    <div class="flex flex-col gap-2">
      <h2
        class="!my-0 text-3xl font-semibold"
        transition:name={`post-title-${id}`}
      >
        {title}
      </h2>
      <div class="text-gray-500 dark:text-white/80">
        {formatDate(pubDate)}
      </div>
      <Tags tags={tags} />
    </div>

    <div class="my-6">
      <slot />
    </div>

    <Tags tags={tags} class="pb-10" />
  </article>
</MainLayout>
