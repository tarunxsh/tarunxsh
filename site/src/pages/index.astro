---
import { Image } from "astro:assets"
import profileImage from "~/assets/profile.jpg"
import Carousel from "~/components/astro/carousel.astro"
import Quote from "~/components/astro/quote.astro"
import LinkCard from "~/components/astro/link-card.astro"
import Marquee from "~/components/astro/marquee.astro"
import Post from "~/components/astro/post.astro"
import MainLayout from "~/layouts/main.astro"
import { skills, LATEST_POSTS_LIMIT, links } from "~/config/index"
import { getPosts } from "~/utils"

const allPosts = await getPosts()
const recentPosts = allPosts.slice(0, LATEST_POSTS_LIMIT)
---

<MainLayout ogImage="/preview.png">

  <!-- Intro -->
  <div class="mb-10">
    <div class="flex flex-col gap-2 sm:flex-row">
      <div class="basis-1/3 self-stretch">
        <div class="relative h-40 w-40 sm:h-auto sm:w-full sm:aspect-square overflow-hidden rounded-full border-4 border-yellow-400">
          <Image
            src={profileImage}
            alt="Tarunesh"
            class="absolute object-cover h-full w-full object-[center_10%] grayscale transition-transform duration-500 hover:scale-105 hover:grayscale-0"
          />
        </div>
      </div>
      <div class="basis-2/3 pt-4 sm:px-4 sm:pt-0">
        <p>Hi there!</p>
        <br/>
        <p>I am Tarunesh, a backend software engineer from Delhi, India. I like building things, and I'm currently inventing with <a class="underline text-blue-500" href="https://albertinvent.com">Albert Invent</a>, helping scientists invent the future...</p>
        <br/>
        <p>Previously worked with <a class="underline text-blue-500" href="https://simpplr.com">Simpplr</a>, building modern intranet applications and integrations.</p>
      </div>
    </div>
  </div>

  <!-- Skills -->
  <div class="my-10 h-50">
    <h3 class="type-section-heading">Hands On</h3>
    <Marquee items={skills} />
  </div>

  <!-- Latest Posts -->
  <div class="my-10">
    <h3 class="type-section-heading">Latest Posts</h3>
    {recentPosts.map((post) => (
      <Post post={post} dateFormat="Mm DD, YYYY" dateWidth="w-32" />
    ))}
  </div>

  <!-- Projects -->
  <div class="my-10">
    <h3 class="type-section-heading">Projects</h3>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {links.map((link) => <LinkCard {...link} />)}
    </div>
  </div>

  <!-- Life -->
  <div class="my-10">
    <h3 class="type-section-heading">Life</h3>
    <Quote text={"I am free and that is why I am lost."} cite={"Franz Kafka"} />
    <Carousel />
  </div>

</MainLayout>
