---
import MainLayout from "~/layouts/main.astro"
import Tags from "~/components/astro/tags.astro"
import TableOfContents from "~/components/astro/table-of-contents.astro"
import { formatDate } from "~/utils"
const { id, title, description, pubDate, updatedDate, heroImage, tags, headings = [] } =
  Astro.props
---

<MainLayout showHeader={false} stickyAside={false}>
  <TableOfContents slot="toc" headings={headings} />
  <article
    class="w-full max-w-3xl overflow-hidden prose dark:prose-invert "
  >
    <div class="flex flex-col gap-1">
      <h2
        class="type-page-title mb-5"
        transition:name={`post-title-${id}`}
      >
        {title}
      </h2>
      <div class="flex items-center gap-3 text-sm text-gray-500 dark:text-white/80">
        <span>{formatDate(pubDate)}</span>
        <Tags tags={tags} />
      </div>
    </div>

    <div class="">
      <slot />
    </div>

    <div>
      <Tags tags={tags} />
    </div>
  </article>
</MainLayout>
