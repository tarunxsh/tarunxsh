---
import type { CollectionEntry } from "astro:content"
import MainLayout from "~/layouts/main.astro"
import Post from "~/components/astro/post.astro"
import { getPosts } from "~/utils"

export async function getStaticPaths() {
  const posts = await getPosts()
  const uniqueTags = [
    ...new Set(posts.flatMap((post) => post.data.tags || [])),
  ]

  return uniqueTags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      filteredPosts: posts.filter((post) => post.data.tags?.includes(tag)),
    },
  }))
}

const { filteredPosts, tag } = Astro.props
---

<MainLayout>
  <div class="type-section-heading">#{tag}</div>

  {
    filteredPosts.length > 0 ? (
      <ul class="space-y-4">
        {filteredPosts.map((post: CollectionEntry<"blog">) => (
          <Post post={post} dateFormat="YYYY-MM-DD" dateWidth="w-32" />
        ))}
      </ul>
    ) : (
      <p class="text-gray-500">No posts found for tag</p>
    )
  }
</MainLayout>
