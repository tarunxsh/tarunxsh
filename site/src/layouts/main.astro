---
import Footer from "~/layouts/footer.astro"
import Header from "~/layouts/header.astro"
import Navigation from "~/layouts/nav.astro"
import BaseLayout from "~/layouts/base.astro"

const { title, description, ogImage, showHeader = true, stickyAside = true } = Astro.props
const filename = Astro.url.pathname.split("/").filter(Boolean).pop() ?? ""
const openGraphImage = filename ? `/og/${filename}.png` : `/og/home.png`
---

<BaseLayout
  title={title}
  description={description}
  ogImage={openGraphImage}

>
  <main class="flex w-full max-w-3xl flex-col">
    {showHeader && <Header />}
    <div class="lg:hidden">
      <Navigation />
    </div>
    <div class="mt-5 flex-1">
      <slot />
    </div>
    <Footer />
  </main>
  <aside class:list={["hidden lg:flex lg:w-56 lg:shrink-0 lg:flex-col lg:pl-8 lg:mt-24", stickyAside && "lg:sticky lg:self-start lg:top-8"]}>
    <Navigation />
    <slot name="toc" />
  </aside>
</BaseLayout>
