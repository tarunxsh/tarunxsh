---
interface Props {
  post: any
  dateFormat?: string
  dateWidth?: string
}

const { post, dateFormat = "default", dateWidth = "w-36" } = Astro.props
import { formatDate } from "~/utils"
---

<div class="my-3 flex md:my-2">
  <p class={`${dateWidth} shrink-0 truncate text-gray-500 dark:text-gray-400`}>
    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, dateFormat)}</time>
  </p>
  <a
    href={`/posts/${post.id}/`}
    data-umami-event={`post-${post.id}`}
    class="line-clamp-2 hover:underline visited:text-purple-500/90"
  >{post.data.title}</a>
</div>
