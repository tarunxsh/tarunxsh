---
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/life/*.{jpg,jpeg,JPG,JPEG,png,gif}"
)
const images = await Promise.all(
  Object.values(imageModules).map((mod) => mod().then((m) => m.default))
)
---

<div>
  <div
    class="slides flex h-64 snap-x snap-mandatory overflow-x-scroll overflow-y-hidden scroll-smooth"
  >
    {
      images.map((img, idx) => (
        <Image
          class="shrink-0 snap-center h-full w-auto object-cover px-1 py-2 select-none"
          src={img}
          height={256}
          loading="lazy"
          draggable={false}
          oncontextmenu="return false"
          alt={`Photo ${idx + 1}`}
        />
      ))
    }
  </div>
  <div class="flex justify-end">
    <a href="/life" class="font-medium text-blue-600 hover:underline"
      >See more &rarr;</a
    >
  </div>
</div>

<script>
  const slides = document.querySelector<HTMLElement>(".slides")!

  const cursorLeft = "w-resize"
  const cursorRight = "e-resize"

  slides.addEventListener("mousemove", (e) => {
    const { left, width } = slides.getBoundingClientRect()
    slides.style.cursor = e.clientX - left < width / 2 ? cursorLeft : cursorRight
  })

  slides.addEventListener("click", (e) => {
    const { left, width } = slides.getBoundingClientRect()
    const x = e.clientX - left
    const scrollAmount = width * 0.8
    slides.scrollBy({ left: x < width / 2 ? -scrollAmount : scrollAmount, behavior: "smooth" })
  })
</script>
